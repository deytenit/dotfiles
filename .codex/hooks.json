{
  "description": "Send Codex lifecycle state to the Zellij agent status bar.",
  "hooks": {
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "python3 ~/.config/zellij/agent-status.py codex-hook", "timeout": 3}]}],
    "PermissionRequest": [{"hooks": [{"type": "command", "command": "python3 ~/.config/zellij/agent-status.py codex-hook", "timeout": 3}]}],
    "PostToolUse": [{"hooks": [{"type": "command", "command": "python3 ~/.config/zellij/agent-status.py codex-hook", "timeout": 3}]}],
    "SubagentStart": [{"hooks": [{"type": "command", "command": "python3 ~/.config/zellij/agent-status.py codex-hook", "timeout": 3}]}],
    "SubagentStop": [{"hooks": [{"type": "command", "command": "python3 ~/.config/zellij/agent-status.py codex-hook", "timeout": 3}]}],
    "Interrupt": [{"hooks": [{"type": "command", "command": "python3 ~/.config/zellij/agent-status.py codex-hook", "timeout": 3}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "python3 ~/.config/zellij/agent-status.py codex-hook", "timeout": 3}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "python3 ~/.config/zellij/agent-status.py codex-hook", "timeout": 3}]}]
  }
}
