# Ignore everything by default.

# Root
!README.md

# Git
!.gitconfig
!.gitignore

# Assets
!assets/
assets/**
!assets/**/*

# Config
!.config/
.config/*

# Dunst
!.config/dunst
.config/dunst/**
!.config/dunst/dunstrc

# Fish
!.config/fish
.config/fish/**
!.config/fish/config.fish
!.config/fish/functions.fish
!.config/fish/aliases.fish

# Hyprland
!.config/hypr
.config/hypr/**
!.config/hypr/**/*

# Neovim
!.config/nvim
.config/nvim/**
!.config/nvim/**/*
.config/nvim/lazy-lock.json

# Rofi
!.config/rofi
.config/rofi/**
!.config/rofi/**/*

# Waybar
!.config/waybar
.config/waybar/**
!.config/waybar/**/*
.config/waybar/.*
!.config/waybar/.theme.css

# Zellij
!.config/zellij
.config/zellij/**
!.config/zellij/config.kdl
!.config/zellij/layouts/*.kdl
!.config/zellij/agent-status.py
!.config/zellij/agent-status/
!.config/zellij/agent-status/Cargo.toml
!.config/zellij/agent-status/Cargo.lock
!.config/zellij/agent-status/src/
!.config/zellij/agent-status/src/main.rs
!.config/zellij/plugins/
!.config/zellij/plugins/agent-status.wasm
## Ignore local (private) layouts
.config/zellij/layouts/*-local.kdl

# Darkman
!.config/darkman
.config/darkman/**
!.config/darkman/**/*

# Skhd
!.config/skhd
.config/skhd/*
!.config/skhd/skhdrc

# Yabai
!.config/yabai
.config/yabai/*
!.config/yabai/yabairc

## Alacritty
!.config/alacritty
.config/alacritty/**
!.config/alacritty/**/*

!.config/ghostty
.config/ghostty/**
!.config/ghostty/**/*

## XDG desktop portal
!.config/xdg-desktop-portal
.config/xdg-desktop-portal/**
!.config/xdg-desktop-portal/**/*

# Hammerspoon
!.hammerspoon
.hammerspoon/**
!.hammerspoon/**/*

# .local
!.local
.local/**
!.local/**/*

# bootstrap
!bootstrap.py
!**/strap*.yaml

# opencode
!.config/opencode
.config/opencode/**
!.config/opencode/**/*

# gemini
!.gemini
.gemini/**
!.gemini/settings.json

# Codex
!.codex
.codex/**
!.codex/strap.yaml
!.codex/status.strap.yaml
!.codex/hooks.json
!.codex/agents/
!.codex/agents/**

# Still to ignore
__pycache__
